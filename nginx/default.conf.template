# Serves the built single-page app. ${API_ORIGIN} and ${SENTRY_ORIGIN} are
# filled in from the environment when the container starts.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers, on every response. Locations below must not use
    # add_header, or nginx drops these there.
    #   - Scripts, styles, fonts and images only from this site; API calls only
    #     to this site, the API and (if set) Sentry.
    #   - The site can't be framed (clickjacking).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN} ${SENTRY_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # For load balancers and uptime checks.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Built assets have content hashes in their names: cache them for good.
    location /assets/ {
        expires max;
        try_files $uri =404;
    }

    # Every other path is a page of the app: serve index.html, never cached,
    # so a new release is picked up on the next visit.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}

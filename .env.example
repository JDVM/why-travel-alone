REACT_APP_API_URL= "url that for where you are running the backed api"
REACT_APP_API_PORT= "This is the port that is being used on the backend"

# Error reporting (optional). Leave unset to turn it off. These are read when
# the app is built, and the DSN is public by design (it can only send events).
# REACT_APP_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# REACT_APP_SENTRY_ENVIRONMENT=production
# REACT_APP_SENTRY_RELEASE=<git sha or version>

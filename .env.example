# Where the API runs, for local development: REACT_APP_API_URL plus REACT_APP_API_PORT.
REACT_APP_API_URL=http://localhost
REACT_APP_API_PORT=8080
# Or the API's full address (used by the Docker image and production builds).
# Takes precedence over the two above.
# REACT_APP_API_BASE_URL=https://api.example.com

# Error reporting (optional). Leave unset to turn it off. These are read when
# the app is built, and the DSN is public by design (it can only send events).
# REACT_APP_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# REACT_APP_SENTRY_ENVIRONMENT=production
# REACT_APP_SENTRY_RELEASE=<git sha or version>
